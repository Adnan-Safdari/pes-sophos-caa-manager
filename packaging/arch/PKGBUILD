pkgname=sophos-caa-manager
pkgver=0.1.0
pkgrel=1
pkgdesc='Unofficial Linux manager for Sophos Client Authentication Agent'
arch=('any')
url='https://github.com/Adnan-Safdari/pes-sophos-caa-manager'
license=('MIT')
depends=(
  'python>=3.11'
  'python-gobject'
  'gtk3'
  'networkmanager'
  'systemd'
  'libayatana-appindicator'
)
makedepends=(
  'python-build'
  'python-installer'
  'python-setuptools'
  'python-wheel'
)
checkdepends=('python-pytest')
source=(
  "$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz"
)
sha256sums=('REPLACE_WITH_RELEASE_TARBALL_SHA256')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname-$pkgver"
  PYTHONPATH=src python -m pytest -q
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
